{
  "name": "jadeai",
  "version": "0.7.0",
  "private": true,
  "packageManager": "pnpm@11.0.9",
  "homepage": "https://holtwood-forks.github.io/JadeAI/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/holtwood-forks/JadeAI.git"
  },
  "bugs": {
    "url": "https://github.com/holtwood-forks/JadeAI/issues"
  },
  "scripts": {
    "dev": "next dev --turbopack",
    "build:export-css": "tsx scripts/build-export-css.ts",
    "prebuild": "pnpm build:export-css",
    "build": "next build",
    "docker:build": "BUILD_ONLY=true bash ./docker_run_local.sh",
    "docker:run": "bash ./docker_run_local.sh",
    "docker:smoke": "bash ./scripts/docker-smoke.sh",
    "docker:publish": "bash ./docker_publish.sh",
    "release:check": "bash ./scripts/verify-release.sh",
    "start": "next start",
    "start:standalone": "node .next/standalone/server.js",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "type-check": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:generate:pg": "drizzle-kit generate --config drizzle-pg.config.ts",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx src/lib/db/seed.ts",
    "db:backup": "tsx scripts/backup-db.ts"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.50",
    "@ai-sdk/google": "^3.0.34",
    "@ai-sdk/openai": "^3.0.26",
    "@ai-sdk/react": "^3.0.80",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fingerprintjs/fingerprintjs": "^5.0.1",
    "@sparticuz/chromium-min": "^143.0.4",
    "ai": "^6.0.78",
    "better-sqlite3": "^13.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "docx": "^9.0.0",
    "drizzle-orm": "^0.45.4",
    "jsonrepair": "^3.13.2",
    "lucide-react": "^0.563.0",
    "mupdf": "^1.27.0",
    "next": "16.4.5",
    "next-auth": "5.0.0-beta.32",
    "next-intl": "^4.14.9",
    "next-themes": "^0.4.6",
    "postgres": "^3.4.8",
    "puppeteer-core": "^25.16.0",
    "qrcode": "^1.5.4",
    "radix-ui": "^1.4.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-markdown": "^10.1.0",
    "recharts": "^3.8.1",
    "remark-gfm": "^4.0.1",
    "server-only": "^0.0.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.4.0",
    "zod": "^4.6.7",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^20",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.0.2",
    "drizzle-kit": "^0.31.9",
    "esbuild": "^0.28.2",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "shadcn": "^3.8.4",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.8"
  }
}
