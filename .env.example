# ===== App =====
APP_NAME=JadeAI

# ===== Fork Links =====
PUBLIC_GITHUB_REPO=holtwood-forks/JadeAI

# Public base URL used to build share links and metadata.
# Leave it commented out for local/LAN use: links then use the request's own
# origin. Set it when deploying behind a domain or reverse proxy, e.g.
# PUBLIC_SITE_URL=https://resume.example.com
# PUBLIC_SITE_URL=https://holtwood-forks.github.io/JadeAI

# ===== Auth =====
AUTH_ENABLED=false
AUTH_SECRET=your-auth-secret-key-change-me

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ===== Database =====
# sqlite (default, zero-config) or postgresql
DB_TYPE=sqlite

# PostgreSQL (set DB_TYPE=postgresql, then uncomment)
# DATABASE_URL=postgresql://user:password@localhost:5432/jadeai

# SQLite (when DB_TYPE=sqlite)
SQLITE_PATH=./data/jade.db

# ===== AI =====
# Optional: enable built-in server-side AI for Docker/self-hosting
# If AI_PROVIDER is omitted, JadeAI auto-detects the first configured provider key.
AI_PROVIDER=openai
AI_MODEL=gpt-4o
# Chat stream defaults (reduce mid-response truncation that otherwise needs manual "continue")
AI_CHAT_MAX_OUTPUT_TOKENS=8192
AI_CHAT_STREAM_TIMEOUT_MS=300000
AI_CHAT_STREAM_CHUNK_TIMEOUT_MS=90000

# OpenAI-compatible
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o

# Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# Google Gemini
GOOGLE_GENERATIVE_AI_API_KEY=
GOOGLE_GENERATIVE_AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GOOGLE_GENERATIVE_AI_MODEL=gemini-2.0-flash

# ===== Runtime =====
# Run as a single local-user instance: every request maps to the fixed `local`
# user, skipping fingerprint and NextAuth. Intended for local/LAN/Tailscale use;
# put an authentication layer in front before exposing it publicly.
JADE_SINGLE_USER=
# Historical alias from the Electron client. `JADE_RUNTIME=desktop` behaves like
# JADE_SINGLE_USER=true and additionally forces SQLite. Kept for existing installs.
# Mutually exclusive with AUTH_ENABLED=true: the server refuses to start if both are set.
JADE_RUNTIME=
# Interviewer-side recruit module. Set to `false` for a resume-only install.
FEATURE_RECRUIT=true
# Set to `dashboard` to skip the landing page and open the dashboard at `/`.
JADE_HOME=

# ===== PDF export (Chromium) =====
# Concurrent resume exports per process. Lower to 1 on a 1 GB host.
# PDF_MAX_CONCURRENT=2
# Close the shared Chromium after this many idle milliseconds (default 10 min).
# Lower it to free ~100-200 MB sooner on memory-constrained hosts.
# PDF_BROWSER_IDLE_MS=600000

# ===== PDF Export =====
# Point at an installed Chrome/Chromium binary. On WSL, bash wrappers that
# exec the Windows chrome.exe (e.g. ~/.local/bin/chromium -> /mnt/c/.../chrome.exe)
# do work for PDF export via WSL interop; set this only if the browser-launch
# stage hangs in your environment (then point it at a Linux-native browser).
# CHROME_PATH=/path/to/chrome-or-chromium
# Explicitly permit downloading the bundled Chromium at runtime (off by default).
# ALLOW_CHROMIUM_DOWNLOAD=false

# ===== i18n =====
DEFAULT_LOCALE=zh
